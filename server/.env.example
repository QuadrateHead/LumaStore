# Copy to .env.development.local and replace the placeholders with URLs from Neon.
# Use Neon's pooled endpoint for application queries and its direct endpoint for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@EP-POOLER.REGION.aws.neon.tech/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@EP.REGION.aws.neon.tech/DATABASE?sslmode=require"
